<Window x:Class="PyleCentury.Menu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pyle Century"
        Height="700"
        Width="1120"
        MinHeight="660"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#071018">

    <Window.Resources>
        <Style x:Key="AppCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1620"/>
            <Setter Property="BorderBrush" Value="#263241"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="LaunchButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PYLE" Foreground="#D1D5DB" FontWeight="Black" FontSize="34" FontStyle="Italic"/>
                    <TextBlock Text="⚡" Foreground="#F97316" FontWeight="Black" FontSize="36" Margin="6,-6,6,0"/>
                    <TextBlock Text="CENTURY" Foreground="#F97316" FontWeight="Black" FontSize="34" FontStyle="Italic"/>
                </StackPanel>
                <TextBlock Text="Built on legacy, designed for the future."
                           Foreground="#94A3B8" FontSize="14" Margin="2,5,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="AdminButton" Content="Admin" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="Admin_Click" Margin="0,0,8,0"/>
                <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Width="100" Click="RefreshProfile_Click" Margin="0,0,8,0"/>
                <Button Content="Exit" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="Exit_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#0B1620" BorderBrush="#263241" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width=".8*"/>
                    <ColumnDefinition Width=".8*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="User:" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UserText" Text="Loading..." Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="ID:" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EmployeeIdText" Text="-" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Terminal:" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HomeTerminalText" Text="-" Foreground="#F97316" FontSize="16" FontWeight="Black" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="3"
                           x:Name="ProfileMessageText"
                           Text=""
                           Foreground="#64748B"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ClipToBounds="True">
            <Grid x:Name="ProgramsFront" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ProgramsTransform"/>
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Applications"
                           Foreground="#F8FAFC"
                           FontSize="24"
                           FontWeight="Black"
                           Margin="4,0,0,10"/>

                <UniformGrid Grid.Row="1" Columns="3">
                    <Border Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="72" Height="72" Background="#111827" BorderBrush="#F97316" BorderThickness="2" CornerRadius="18" HorizontalAlignment="Left">
                                    <TextBlock Text="▥" Foreground="#F97316" FontSize="40" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Dock Commander" Foreground="#F8FAFC" FontSize="24" FontWeight="Bold" Margin="0,18,0,8"/>
                                <TextBlock Text="Dock doors, racks, trailers, hazmat indicators, and operations visibility."
                                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Terminal access is controlled by your employee profile."
                                       Foreground="#CBD5E1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>

                            <Button Grid.Row="2" x:Name="DockCommanderButton" Content="Open Dock Commander" Style="{StaticResource LaunchButtonStyle}" Click="OpenDockCommander_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="72" Height="72" Background="#111827" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="18" HorizontalAlignment="Left">
                                    <TextBlock Text="◫" Foreground="#38BDF8" FontSize="40" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Billing" Foreground="#F8FAFC" FontSize="24" FontWeight="Bold" Margin="0,18,0,8"/>
                                <TextBlock Text="Create PROs, customer lookup, consignee/account data, and shipment save/load."
                                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Billing availability is controlled by your employee profile."
                                       Foreground="#CBD5E1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>

                            <Button Grid.Row="2" x:Name="BillingButton" Content="Open Billing" Style="{StaticResource LaunchButtonStyle}" Click="OpenBilling_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="72" Height="72" Background="#111827" BorderBrush="#22C55E" BorderThickness="2" CornerRadius="18" HorizontalAlignment="Left">
                                    <TextBlock Text="⇄" Foreground="#22C55E" FontSize="40" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="RPS" Foreground="#F8FAFC" FontSize="24" FontWeight="Bold" Margin="0,18,0,8"/>
                                <TextBlock Text="Route planning, buckets, clipped runs, and live bucket locking."
                                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Program-based RPS foundation. Bucket locks show who is currently routing."
                                       Foreground="#CBD5E1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>

                            <Button Grid.Row="2" x:Name="RpsButton" Content="Open RPS" Style="{StaticResource LaunchButtonStyle}" Click="OpenRps_Click"/>
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>

            <Grid x:Name="AdminFront" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="AdminTransform" X="1140"/>
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="4,0,0,10">
                    <TextBlock Text="Admin"
                               Foreground="#F8FAFC"
                               FontSize="24"
                               FontWeight="Black"
                               DockPanel.Dock="Left"/>
                    <Button Content="Back to Apps"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="120"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Click="BackToApps_Click"/>
                </DockPanel>

                <UniformGrid Grid.Row="1" Columns="3">
                    <Border Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="72" Height="72" Background="#111827" BorderBrush="#F97316" BorderThickness="2" CornerRadius="18" HorizontalAlignment="Left">
                                    <TextBlock Text="👥" Foreground="#F97316" FontSize="34" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Employee Manager" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,18,0,8"/>
                                <TextBlock Text="Create, edit, deactivate, or delete employees and access levels through the Render/Supabase backend."
                                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Content="Open Employee Manager"
                                    Style="{StaticResource LaunchButtonStyle}"
                                    Click="OpenEmployeeManager_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}" Opacity=".55">
                        <StackPanel>
                            <TextBlock Text="Terminal Admin" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Coming later: terminal list, mapped dock layouts, terminal metadata, terminal scan codes."
                                       Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}" Opacity=".55">
                        <StackPanel>
                            <TextBlock Text="Route Grid Admin" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Coming later: route areas, zip codes, route buckets, and terminal route maintenance."
                                       Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="72" Height="72" Background="#111827" BorderBrush="#22C55E" BorderThickness="2" CornerRadius="18" HorizontalAlignment="Left">
                                    <TextBlock Text="⇄" Foreground="#22C55E" FontSize="40" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="RPS" Foreground="#F8FAFC" FontSize="24" FontWeight="Bold" Margin="0,18,0,8"/>
                                <TextBlock Text="Route planning, buckets, clipped runs, and live bucket locking."
                                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Program-based RPS foundation. Bucket locks show who is currently routing."
                                       Foreground="#CBD5E1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>

                            <Button Grid.Row="2" x:Name="RpsButton" Content="Open RPS" Style="{StaticResource LaunchButtonStyle}" Click="OpenRps_Click"/>
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Text="Ready"
                   Foreground="#94A3B8"
                   VerticalAlignment="Center"
                   FontSize="12"/>
    </Grid>
</Window>
