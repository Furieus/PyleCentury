<Window x:Class="DockCommander.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pyle Century"
        Height="620"
        Width="980"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#1E1E1E"
        AllowsTransparency="False">

    <Window.Resources>
        <SolidColorBrush x:Key="OrangeBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="DarkPanelBrush" Color="#262626"/>
        <SolidColorBrush x:Key="DeepPanelBrush" Color="#171717"/>
        <SolidColorBrush x:Key="LineBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="SoftTextBrush" Color="#A3A3A3"/>

        <Style x:Key="ContinueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Minimal technical background accents -->
        <Grid Opacity="0.22">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="#3F3F46" BorderThickness="0,1,0,0"/>
            <Border Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="#3F3F46" BorderThickness="0,1,0,0"/>
            <Border Grid.RowSpan="4" Grid.Column="1" BorderBrush="#3F3F46" BorderThickness="1,0,0,0"/>
            <Border Grid.RowSpan="4" Grid.Column="2" BorderBrush="#3F3F46" BorderThickness="1,0,0,0"/>
        </Grid>

        <!-- Orange accent corner frame -->
        <Path Stroke="#F97316"
              StrokeThickness="4"
              Data="M 34 34 L 260 34 M 34 34 L 34 154"
              StrokeStartLineCap="Square"
              StrokeEndLineCap="Square"/>

        <Path Stroke="#000000"
              StrokeThickness="2"
              Data="M 38 42 L 240 42 M 42 38 L 42 140"
              Opacity="0.8"/>

        <Grid Margin="58,54,58,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Pyle"
                               Foreground="#F97316"
                               FontSize="36"
                               FontWeight="Black">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Viewbox Grid.Column="1" Width="32" Height="38" Margin="2,-2,2,0">
                        <Path Fill="#F97316"
                              Stroke="#000000"
                              StrokeThickness="1.4"
                              Data="M 18 0 L 4 22 L 16 22 L 11 42 L 31 15 L 19 15 Z"/>
                    </Viewbox>

                    <TextBlock Grid.Column="2"
                               Text="Century"
                               Foreground="#F97316"
                               FontSize="36"
                               FontWeight="Black">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <TextBlock Text="Built on Legacy, Designed for the future."
                           Foreground="#D4D4D8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="2,6,0,0"/>
            </StackPanel>

            <!-- Center technical content -->
            <Grid Grid.Row="1">
                <Border Width="560"
                        Height="230"
                        Background="#202020"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="DOCK COMMANDER"
                                   Foreground="#FFFFFF"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding LoadingMessage}"
                                   Foreground="#A3A3A3"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <Grid Margin="0,18,0,0">
                                <Border Height="24"
                                        Background="#111111"
                                        BorderBrush="#000000"
                                        BorderThickness="2"
                                        CornerRadius="4"/>

                                <ProgressBar Height="18"
                                             Margin="4,3"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding LoadProgress}"
                                             Foreground="#F97316"
                                             Background="#111111"
                                             BorderThickness="0"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="{Binding ProgressText}"
                                           Foreground="#F97316"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="SYSTEM INITIALIZATION"
                                           Foreground="#71717A"
                                           FontSize="11"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Row="3"
                                Content="CONTINUE"
                                Style="{StaticResource ContinueButtonStyle}"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ContinueVisibility}"
                                Click="ContinueButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom line -->
            <TextBlock Grid.Row="2"
                       Text="over 100 years of Pyle delivering service!"
                       Foreground="#D4D4D8"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,16"/>

            <!-- Footer controls -->
            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse Width="8" Height="8" Fill="#F97316" Margin="0,0,8,0"/>
                    <TextBlock Text="Legacy systems online"
                               Foreground="#A3A3A3"
                               FontSize="12"/>
                </StackPanel>

                <Button Content="EXIT"
                        HorizontalAlignment="Right"
                        Width="70"
                        Height="28"
                        Background="#262626"
                        Foreground="#A3A3A3"
                        BorderBrush="#3F3F46"
                        Click="ExitButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
