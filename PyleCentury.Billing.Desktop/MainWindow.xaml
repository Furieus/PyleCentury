<Window x:Class="PyleCentury.Billing.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pyle Century Billing"
        Height="940"
        Width="1380"
        MinHeight="850"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#071018">

    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1620"/>
            <Setter Property="BorderBrush" Value="#263241"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValueBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReadOnlyBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ValueBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,0,18,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PYLE" Foreground="#D1D5DB" FontWeight="Black" FontSize="28" FontStyle="Italic"/>
                <TextBlock Text="⚡" Foreground="#F97316" FontWeight="Black" FontSize="29" Margin="4,-4,4,0"/>
                <TextBlock Text="CENTURY" Foreground="#F97316" FontWeight="Black" FontSize="28" FontStyle="Italic"/>
                <Border Background="#422006" BorderBrush="#F97316" BorderThickness="1" CornerRadius="10" Padding="12,5" Margin="18,0,0,0">
                    <TextBlock Text="BILLING" Foreground="#FED7AA" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="PRO Lookup:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ProLookupBox" Width="150" Style="{StaticResource ValueBoxStyle}" Margin="0,0,8,0"/>
                <Button Content="Load PRO" Style="{StaticResource SecondaryButtonStyle}" Click="LoadPro_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="SHIPPER" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="Locked dummy data" Foreground="#F97316" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ShipperNameBox" Style="{StaticResource ReadOnlyBoxStyle}" Text="A Duie Pyle"/>

                            <TextBlock Text="Address" Style="{StaticResource LabelStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ShipperAddressBox" Style="{StaticResource ReadOnlyBoxStyle}" Text="87 Aircraft Rd"/>

                            <TextBlock Text="City / State / ZIP" Style="{StaticResource LabelStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ShipperCityStateZipBox" Style="{StaticResource ReadOnlyBoxStyle}" Text="Southington, CT 06489"/>

                            <TextBlock Text="Phone" Style="{StaticResource LabelStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ShipperPhoneBox" Style="{StaticResource ReadOnlyBoxStyle}" Text="860-555-0100"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="CONSIGNEE LOOKUP" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="Customer Account Code" Style="{StaticResource LabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="105"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomerCodeBox" Style="{StaticResource ValueBoxStyle}" Text="ABME17" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Lookup" Style="{StaticResource PrimaryButtonStyle}" Click="LookupCustomer_Click"/>
                            </Grid>

                            <TextBlock Text="Name" Style="{StaticResource LabelStyle}" Margin="0,12,0,4"/>
                            <TextBox x:Name="ConsigneeNameBox" Style="{StaticResource ReadOnlyBoxStyle}"/>

                            <TextBlock Text="Address" Style="{StaticResource LabelStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ConsigneeAddressBox" Style="{StaticResource ReadOnlyBoxStyle}"/>

                            <TextBlock Text="City / State / ZIP" Style="{StaticResource LabelStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ConsigneeCityStateZipBox" Style="{StaticResource ReadOnlyBoxStyle}"/>

                            <TextBlock Text="Phone" Style="{StaticResource LabelStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ConsigneePhoneBox" Style="{StaticResource ReadOnlyBoxStyle}"/>

                            <TextBlock Text="Contact" Style="{StaticResource LabelStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ConsigneeContactBox" Style="{StaticResource ReadOnlyBoxStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="SHIPMENT DETAILS" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>

                                <TextBlock Text="Product Description" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ProductDescriptionBox" Style="{StaticResource ValueBoxStyle}" Text="General freight"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Pieces" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="PiecesBox" Style="{StaticResource ValueBoxStyle}" Text="10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Skids" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="SkidsBox" Style="{StaticResource ValueBoxStyle}" Text="3"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Weight lbs" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="WeightBox" Style="{StaticResource ValueBoxStyle}" Text="989"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Class" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="FreightClassBox" Style="{StaticResource ValueBoxStyle}" Text="70"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="NMFC / Commodity Code" Style="{StaticResource LabelStyle}" Margin="0,12,0,4"/>
                                <TextBox x:Name="NmfcBox" Style="{StaticResource ValueBoxStyle}"/>

                                <TextBlock Text="Special Instructions" Style="{StaticResource LabelStyle}" Margin="0,12,0,4"/>
                                <TextBox x:Name="SpecialInstructionsBox" Height="82" Style="{StaticResource ValueBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="12" Padding="16" Margin="18,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PRO NUMBER" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ProNumberText" Text="Not Generated" Foreground="#F97316" FontSize="30" FontWeight="Black" HorizontalAlignment="Center" Margin="0,14,0,16"/>
                                    <Button Content="Generate 9-Digit PRO" Style="{StaticResource PrimaryButtonStyle}" Click="GeneratePro_Click"/>
                                    <TextBlock Text="Unique local tracking number for this shipment." Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="SERVICE REQUIREMENTS" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <CheckBox x:Name="FoodstuffsCheck" Content="Foodstuffs"/>
                                <CheckBox x:Name="LiftgateCheck" Content="Needs Liftgate"/>
                                <CheckBox x:Name="StraightTruckCheck" Content="Needs Straight Truck"/>
                                <CheckBox x:Name="AppointmentCheck" Content="Appointment Required"/>
                                <CheckBox x:Name="LimitedAccessCheck" Content="Limited Access"/>
                                <CheckBox x:Name="CallBeforeCheck" Content="Call Before Delivery"/>
                                <CheckBox x:Name="InsideDeliveryCheck" Content="Inside Delivery"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="HAZMAT" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                                <CheckBox x:Name="HazmatCheck" Content="Hazardous Shipment" HorizontalAlignment="Right" Checked="HazmatCheck_Changed" Unchecked="HazmatCheck_Changed"/>
                            </Grid>

                            <Grid x:Name="HazmatPanel" IsEnabled="False" Opacity="0.38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="UN / NA Number" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="UnNumberBox" Style="{StaticResource ValueBoxStyle}" Text="UN1993"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,10">
                                    <TextBlock Text="Hazmat Class" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="HazmatClassBox" Style="{StaticResource ValueBoxStyle}" Text="3"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Packing Group" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="PackingGroupBox" Style="{StaticResource ValueBoxStyle}" Text="II"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,0,8,0">
                                    <TextBlock Text="Container Type" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="ContainerTypeBox" Style="{StaticResource ValueBoxStyle}" Text="Drum"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="Proper Shipping Name" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="ProperShippingNameBox" Style="{StaticResource ValueBoxStyle}" Text="Flammable Liquid, N.O.S."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="ACTIONS" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Button Content="Save Shipment" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10" Click="SaveShipment_Click"/>
                            <Button Content="Clear Form" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10" Click="ClearForm_Click"/>
                            <Button Content="Load Dummy Consignee" Style="{StaticResource SecondaryButtonStyle}" Click="LookupCustomer_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="WHAT THIS BILL CREATES" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="• A Render-generated 9-digit PRO tracking number" Foreground="#CBD5E1" Margin="0,0,0,8"/>
                            <TextBlock Text="• Locked shipper info" Foreground="#CBD5E1" Margin="0,0,0,8"/>
                            <TextBlock Text="• Consignee pulled by account code from Render/Supabase" Foreground="#CBD5E1" Margin="0,0,0,8"/>
                            <TextBlock Text="• Freight description, pieces, skids and weight" Foreground="#CBD5E1" Margin="0,0,0,8"/>
                            <TextBlock Text="• Hazmat UN/NA number, class, packing group, container and proper shipping name" Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock Text="• Service flags such as liftgate, straight truck, foodstuffs and appointment required" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="STATUS" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock x:Name="StatusText" Text="Ready." Foreground="#22C55E" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="Pyle Century Billing · Dummy shipper mode · Render/Supabase shipment ledger" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Window>
