<Window x:Class="PyleCentury.RPS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pyle Century RPS"
        Height="760"
        Width="1260"
        MinHeight="700"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#071018">

    <Window.Resources>
        <Style x:Key="SmallMenuButtonCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="245"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#F97316"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#0B1620"/>
            <Setter Property="BorderBrush" Value="#263241"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PYLE" Foreground="#D1D5DB" FontWeight="Black" FontSize="30" FontStyle="Italic"/>
                    <TextBlock Text="⚡" Foreground="#F97316" FontWeight="Black" FontSize="32" Margin="6,-6,6,0"/>
                    <TextBlock Text="CENTURY" Foreground="#F97316" FontWeight="Black" FontSize="30" FontStyle="Italic"/>
                    <TextBlock Text=" RPS" Foreground="#22C55E" FontWeight="Black" FontSize="30" Margin="16,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Route Planning System · program shell"
                           Foreground="#94A3B8" FontSize="13" Margin="2,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="UserText" Text="Loading user..." Foreground="#F8FAFC" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="Refresh" Style="{StaticResource ActionButton}" Width="96" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#0B1620" BorderBrush="#263241" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Terminal" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TerminalBox" Style="{StaticResource SmallMenuButtonCombo}" Width="160" SelectionChanged="TerminalBox_SelectionChanged"/>
                    <TextBlock Text="Route Bucket" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <ComboBox x:Name="BucketBox" Style="{StaticResource SmallMenuButtonCombo}" Width="280" SelectionChanged="BucketBox_SelectionChanged"/>
                </StackPanel>

                <TextBlock x:Name="LockBannerText"
                           DockPanel.Dock="Right"
                           Text="Select a bucket"
                           Foreground="#F97316"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width=".9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Freight Bucket" Foreground="#F8FAFC" FontSize="18" FontWeight="Black" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" x:Name="BucketStopsList" Background="#071018" Foreground="#F8FAFC" BorderBrush="#263241">
                        <ListBoxItem Content="Program shell — bucket freight will load from Render/Supabase"/>
                        <ListBoxItem Content="Locked bucket = view-only mode"/>
                        <ListBoxItem Content="Editable bucket = drag stops into active run"/>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Active Run" Foreground="#F8FAFC" FontSize="18" FontWeight="Black" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" x:Name="ActiveRunList" Background="#071018" Foreground="#F8FAFC" BorderBrush="#263241"/>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="ClipButton" Content="Clip" Style="{StaticResource ActionButton}" Width="82" Margin="0,0,8,0"/>
                        <Button x:Name="UnclipButton" Content="Unclip" Style="{StaticResource ActionButton}" Width="82" Margin="0,0,8,0"/>
                        <Button x:Name="SaveButton" Content="Save Run" Style="{StaticResource ActionButton}" Width="100" Margin="0,0,8,0"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Clipped Runs / Locks" Foreground="#F8FAFC" FontSize="18" FontWeight="Black" Margin="0,0,0,10"/>
                    <TextBlock Text="Bucket dropdown will show lock/eyes indicators when someone else is routing."
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <ListBox x:Name="LockList" Height="320" Background="#071018" Foreground="#F8FAFC" BorderBrush="#263241"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready" Foreground="#94A3B8" VerticalAlignment="Center"/>
    </Grid>
</Window>
