<Window x:Class="DockCommander.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock Commander - Operations Overview"
        Height="960"
        Width="1600"
        MinHeight="850"
        MinWidth="1300"
        Background="#071018"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="OrangeBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="PageBrush" Color="#071018"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1620"/>
        <SolidColorBrush x:Key="PanelBrush2" Color="#111827"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#263241"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1620"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#263241"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DoorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="31"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <DataTemplate x:Key="DoorTemplate">
            <Grid Width="37">
                <StackPanel Visibility="{Binding DoorVisibility}">
                    <TextBlock Text="{Binding DisplayNumber}"
                               Foreground="#E5E7EB"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <Button Style="{StaticResource DoorButtonStyle}"
                            Content="{Binding DisplayNumber}"
                            Background="{Binding StatusBrush}"
                            ToolTip="{Binding ToolTipText}"
                            Click="DoorButton_Click"/>
                    <TextBlock Text="▾"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Border Width="31"
                        Height="50"
                        Margin="3,18,3,0"
                        Background="#071018"
                        BorderBrush="#263241"
                        BorderThickness="1"
                        Opacity="0.35"
                        Visibility="{Binding SpacerVisibility}"
                        ToolTip="{Binding ToolTipText}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RackPairTemplate">
            <Grid Height="22" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{Binding BottomSlot.StatusBrush}"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="3,0,0,3"
                        Margin="0,0,1,0">
                    <TextBlock Text="{Binding BottomSlot.SlotNumber}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="1"
                        Background="{Binding TopSlot.StatusBrush}"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="0,3,3,0"
                        Margin="1,0,0,0">
                    <TextBlock Text="{Binding TopSlot.SlotNumber}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RackTemplate">
            <StackPanel Width="48" Margin="4,0">
                <TextBlock Text="{Binding Name}"
                           Foreground="#E5E7EB"
                           FontWeight="Bold"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Pairs}" ItemTemplate="{StaticResource RackPairTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HazmatTemplate">
            <Grid Width="76" Height="76" Margin="0,0,10,10">
                <Border Background="{Binding PlacardBrush}"
                        BorderBrush="#000000"
                        BorderThickness="2"
                        CornerRadius="6"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>

                <Grid Margin="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Symbol}"
                               Foreground="{Binding TextBrush}"
                               FontSize="18"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Name}"
                               Foreground="{Binding TextBrush}"
                               FontSize="8"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="62"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding ClassCode}"
                               Foreground="{Binding TextBrush}"
                               FontSize="13"
                               FontWeight="Black"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActivityTemplate">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="14" Height="14" Fill="{Binding AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Door}" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                    <TextBlock Text="{Binding Message}" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#64748B" FontSize="11"/>
            </Grid>
        </DataTemplate>
    
        <Style x:Key="TerminalComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="330"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
</Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#06111B" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,30,0,0">
                    <StackPanel Margin="24,0,24,34">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PYLE" Foreground="#D1D5DB" FontWeight="Black" FontSize="25" FontStyle="Italic"/>
                            <TextBlock Text="⚡" Foreground="#F97316" FontSize="26" FontWeight="Black" Margin="3,-3,3,0"/>
                            <TextBlock Text="CENTURY" Foreground="#F97316" FontWeight="Black" FontSize="25" FontStyle="Italic"/>
                        </StackPanel>
                        <TextBlock Text="Dock Commander" Foreground="#94A3B8" FontSize="13" Margin="2,8,0,0"/>
                    </StackPanel>

                    <Button Style="{StaticResource NavButtonStyle}" Background="#422006" Foreground="White" Content="Overview"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Dock Doors"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Racks"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Trailers"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Activity"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Alerts"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Reports"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Settings"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,24">
                    <Border Background="#0B1620" BorderBrush="#263241" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Terminal" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock x:Name="SidebarTerminalText" Text="CON - SOUTHINGTON, CT" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#263241" Margin="0,24"/>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="System Status: Online" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="190"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Operations Overview"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="TerminalSelector"
                          Grid.Column="2"
                          Style="{StaticResource TerminalComboStyle}"
                          DisplayMemberPath="DisplayWithStatus"
                          SelectionChanged="TerminalSelector_SelectionChanged"
                          VerticalAlignment="Center">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding HasDockLayout}"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDockLayout}" Value="False">
                                    <Setter Property="Opacity" Value="0.42"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TerminalPermissionText"
                               Text="Permission: loading"
                               Foreground="#F97316"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"/>
                    <TextBlock x:Name="TerminalShipCodeText"
                               Text=""
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Refresh Terminal"
                            Width="128"
                            Height="32"
                            Background="#111827"
                            Foreground="#E5E7EB"
                            BorderBrush="#374151"
                            FontWeight="Bold"
                            Margin="0,0,18,0"
                            Click="RefreshTerminal_Click"/>
                    <TextBlock Text="9:42 AM"
                               Foreground="#F8FAFC"
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="72°F"
                               Foreground="#F8FAFC"
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"/>
                    <Border Background="#F97316" CornerRadius="12" Padding="8,3">
                        <TextBlock Text="3" Foreground="Black" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- KPI Cards -->
            <UniformGrid Grid.Row="1" Columns="5" Margin="0,4,0,16">
                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="DOCK DOORS IN USE" Foreground="#94A3B8" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="24" Foreground="#F8FAFC" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DoorCountDisplay}" Foreground="#94A3B8" FontSize="15" Margin="8,15,0,0"/>
                        </StackPanel>
                        <TextBlock Text="40% In Use" Foreground="#F97316" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TRAILERS ON SITE" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock Text="38" Foreground="#F8FAFC" FontSize="34" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Live Count" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="STRIPS COMPLETED" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock Text="16" Foreground="#F8FAFC" FontSize="34" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Today" Foreground="#22C55E"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="DELAYED LOADS" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock Text="5" Foreground="#F8FAFC" FontSize="34" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Requires Attention" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="AVERAGE STRIP TIME" Foreground="#94A3B8" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="42" Foreground="#F8FAFC" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="min" Foreground="#94A3B8" FontSize="15" Margin="8,15,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Today" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Middle Content -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,16,14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="108"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="104"/>
                        </Grid.RowDefinitions>

                        <!-- Top doors -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding TopDockLabel}"
                                       Foreground="#F8FAFC"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding TopDoors}"
                                          ItemTemplate="{StaticResource DoorTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="30"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Racks and Details Overlay Host -->
                        <Grid Grid.Row="1" Margin="0,8">
                            <Border BorderBrush="#263241"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Background="#071018"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="RACK LOCATIONS"
                                               Foreground="#F8FAFC"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ItemsControl Grid.Column="0"
                                                      ItemsSource="{Binding LeftRacks}"
                                                      ItemTemplate="{StaticResource RackTemplate}"
                                                      HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="42" Height="150" Background="#111827" BorderBrush="#F97316" BorderThickness="1" CornerRadius="18" Opacity="0.85">
                                                <TextBlock Text="CROSSOVER"
                                                           Foreground="#F97316"
                                                           FontWeight="Bold"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.LayoutTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </TextBlock.LayoutTransform>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="Dock Desk"
                                                       Foreground="#94A3B8"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <ItemsControl Grid.Column="2"
                                                      ItemsSource="{Binding RightRacks}"
                                                      ItemTemplate="{StaticResource RackTemplate}"
                                                      HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                            <Rectangle Width="12" Height="12" Fill="#22C55E" Margin="0,0,7,0"/>
                                            <TextBlock Text="Available" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                            <Rectangle Width="12" Height="12" Fill="#F59E0B" Margin="0,0,7,0"/>
                                            <TextBlock Text="In Use" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                            <Rectangle Width="12" Height="12" Fill="#EF4444" Margin="0,0,7,0"/>
                                            <TextBlock Text="Delayed" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="12" Height="12" Fill="#3F3F46" Margin="0,0,7,0"/>
                                            <TextBlock Text="Offline" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Door details slide-up panel -->
                            <Border x:Name="DoorDetailsPanel"
                                    Width="430"
                                    Background="#111827"
                                    BorderBrush="#F97316"
                                    BorderThickness="1.5"
                                    CornerRadius="18"
                                    Padding="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="DoorDetailsTransform" Y="320"/>
                                </Border.RenderTransform>

                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.65"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Button Content="×"
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#1F2937"
                                            Foreground="#CBD5E1"
                                            BorderBrush="#374151"
                                            Click="CloseDoorDetails_Click"/>

                                    <TextBlock Text="{Binding SelectedDoorDetails.DoorNumber, StringFormat=Door {0}}"
                                               Foreground="#F8FAFC"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <Grid Grid.Row="1" Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Route:" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedDoorDetails.Route}" Foreground="White" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="1" Text="Trailer:" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDoorDetails.Trailer}" Foreground="White" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="2" Text="Total Bills:" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDoorDetails.TotalBills}" Foreground="White" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="3" Text="Loaded:" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedDoorDetails.LoadedDisplay}" Foreground="#F97316" FontWeight="Bold"/>
                                            <TextBlock Text=" complete bills" Foreground="#94A3B8" Margin="5,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="4" Text="Weight:" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDoorDetails.WeightDisplay}" Foreground="White" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Hazmat Placards:" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding SelectedDoorDetails.HazmatPlacards}"
                                                      ItemTemplate="{StaticResource HazmatTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>

                                    <Border Grid.Row="3"
                                            Background="#0B1620"
                                            BorderBrush="#263241"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,16,0,0">
                                        <TextBlock Foreground="#CBD5E1"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Text="Loaded % is based on complete bills only. A bill is complete when every skid for that bill has been loaded."/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Bottom doors -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding BottomDockLabel}"
                                       Foreground="#F8FAFC"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding BottomDoors}"
                                          ItemTemplate="{StaticResource DoorTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="30"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Rail -->
                <Grid Grid.Column="1" Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="ACTIVITY FEED" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="View All" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Activities}" ItemTemplate="{StaticResource ActivityTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
