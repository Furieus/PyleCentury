<Window x:Class="PyleCentury.RPS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pyle Century RPS"
        Height="890"
        Width="1540"
        MinHeight="780"
        MinWidth="1260"
        WindowStartupLocation="CenterScreen"
        Background="#071018">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#071018"/>
        <SolidColorBrush x:Key="Panel" Color="#0B1620"/>
        <SolidColorBrush x:Key="Panel2" Color="#0F1B27"/>
        <SolidColorBrush x:Key="Line" Color="#263241"/>
        <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Text" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Orange" Color="#F97316"/>
        <SolidColorBrush x:Key="OrangeSoft" Color="#FDBA74"/>
        <SolidColorBrush x:Key="Green" Color="#22C55E"/>
        <SolidColorBrush x:Key="Blue" Color="#38BDF8"/>
        <SolidColorBrush x:Key="Red" Color="#EF4444"/>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="TinyMetric" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="#253445"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#241106"/>
            <Setter Property="Foreground" Value="{StaticResource OrangeSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Orange}"/>
        </Style>

        <Style x:Key="DropdownButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="{StaticResource Orange}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="#071018"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#071018"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PYLE" Foreground="#D1D5DB" FontWeight="Black" FontSize="31" FontStyle="Italic"/>
                    <TextBlock Text="⚡" Foreground="{StaticResource Orange}" FontWeight="Black" FontSize="32" Margin="7,-6,7,0"/>
                    <TextBlock Text="CENTURY" Foreground="{StaticResource Orange}" FontWeight="Black" FontSize="31" FontStyle="Italic"/>
                    <Border Background="#12351F" BorderBrush="{StaticResource Green}" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="16,4,0,0">
                        <TextBlock Text="RPS" Foreground="#86EFAC" FontWeight="Black" FontSize="17"/>
                    </Border>
                    <Border x:Name="ReadOnlyTopPill" Visibility="Collapsed" Background="#3B100B" BorderBrush="{StaticResource Red}" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="10,4,0,0">
                        <TextBlock Text="READ ONLY" Foreground="#FCA5A5" FontWeight="Black" FontSize="15"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Route Planning System · native lockout test"
                           Foreground="{StaticResource Muted}" FontSize="13" Margin="2,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="UserText" Text="Loading user..." Foreground="{StaticResource Text}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="Refresh" Style="{StaticResource ActionButton}" Width="96" Click="Refresh_Click"/>
                <Button Content="Release Lock" Style="{StaticResource OrangeButton}" Width="126" Margin="8,0,0,0" Click="ReleaseLock_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Terminal" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="2,0,0,5"/>
                        <Button x:Name="TerminalButton" Width="150" Style="{StaticResource DropdownButton}" Click="TerminalButton_Click">
                            <DockPanel>
                                <TextBlock x:Name="TerminalButtonText" Text="CON" DockPanel.Dock="Left" Foreground="{StaticResource Text}" FontWeight="Bold"/>
                                <TextBlock Text="▾" DockPanel.Dock="Right" Foreground="{StaticResource Orange}" FontWeight="Black"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="Route Bucket" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="2,0,0,5"/>
                        <Button x:Name="BucketButton" Width="390" Style="{StaticResource DropdownButton}" Click="BucketButton_Click">
                            <DockPanel>
                                <TextBlock x:Name="BucketButtonText" Text="Select route bucket" DockPanel.Dock="Left" Foreground="{StaticResource Text}" FontWeight="Bold"/>
                                <TextBlock Text="▾" DockPanel.Dock="Right" Foreground="{StaticResource Orange}" FontWeight="Black"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Popup x:Name="BucketPopup" PlacementTarget="{Binding ElementName=BucketButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Width="390" MaxHeight="430" Background="#071018" BorderBrush="{StaticResource Orange}" BorderThickness="1" CornerRadius="12" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="BucketDropdownList"
                                     Background="#071018"
                                     Foreground="{StaticResource Text}"
                                     BorderThickness="0"
                                     SelectionChanged="BucketDropdownList_SelectionChanged"/>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <UniformGrid Grid.Column="1" Columns="4" Margin="24,0,18,0">
                    <Border Style="{StaticResource TinyMetric}">
                        <StackPanel>
                            <TextBlock Text="Stops" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="StopsMetric" Text="--" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TinyMetric}">
                        <StackPanel>
                            <TextBlock Text="Weight" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="WeightMetric" Text="--" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TinyMetric}">
                        <StackPanel>
                            <TextBlock Text="Cube" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="CubeMetric" Text="--" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TinyMetric}">
                        <StackPanel>
                            <TextBlock Text="Mode" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="ModeMetric" Text="--" Foreground="{StaticResource Green}" FontSize="18" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Column="2" Background="#241106" BorderBrush="{StaticResource Orange}" BorderThickness="1" CornerRadius="13" Padding="14,8" MinWidth="300">
                    <StackPanel>
                        <TextBlock Text="BUCKET LOCK" Foreground="{StaticResource OrangeSoft}" FontSize="11" FontWeight="Black"/>
                        <TextBlock x:Name="LockBannerText" Text="Select a bucket" Foreground="{StaticResource Text}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width=".95*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Freight Bucket" DockPanel.Dock="Left" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Black"/>
                        <TextBlock x:Name="ReadOnlyBadgeLeft" Text="" DockPanel.Dock="Right" Foreground="#FCA5A5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="BucketStopsList" Style="{StaticResource DarkList}">
                        <ListBoxItem Content="Select a route bucket to test lockout."/>
                    </ListBox>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="MoveToRunButton" Content="Move → Run" Style="{StaticResource ActionButton}" Width="112" Margin="0,0,8,0"/>
                        <Button x:Name="RemoveStopButton" Content="Remove" Style="{StaticResource ActionButton}" Width="88"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.25*"/>
                        <RowDefinition Height=".75*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Live Active Run Map" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Black"/>
                            <TextBlock Text="Map stays internal. Renderer comes after lockout workflow is stable."
                                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ReadOnlyBadgeCenter" DockPanel.Dock="Right" Text="" Foreground="#FCA5A5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#08131E" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="INTERNAL MAP AREA"
                                       Foreground="#334155"
                                       FontSize="34"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Canvas ClipToBounds="True">
                                <Line X1="120" Y1="90" X2="280" Y2="176" Stroke="#64748B" StrokeThickness="2"/>
                                <Line X1="280" Y1="176" X2="452" Y2="118" Stroke="#64748B" StrokeThickness="2"/>
                                <Line X1="452" Y1="118" X2="590" Y2="220" Stroke="#64748B" StrokeThickness="2"/>
                                <Ellipse Width="18" Height="18" Fill="{StaticResource Green}" Canvas.Left="111" Canvas.Top="81"/>
                                <Ellipse Width="18" Height="18" Fill="{StaticResource Orange}" Canvas.Left="271" Canvas.Top="167"/>
                                <Ellipse Width="18" Height="18" Fill="{StaticResource Blue}" Canvas.Left="443" Canvas.Top="109"/>
                                <Ellipse Width="18" Height="18" Fill="#A855F7" Canvas.Left="581" Canvas.Top="211"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" x:Name="ActiveRunList" Style="{StaticResource DarkList}">
                        <ListBoxItem Content="Active run will be editable only when you own the bucket lock."/>
                    </ListBox>

                    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button x:Name="ClipButton" Content="Clip" Style="{StaticResource OrangeButton}" Width="82" Margin="0,0,8,0"/>
                        <Button x:Name="UnclipButton" Content="Unclip" Style="{StaticResource ActionButton}" Width="82" Margin="0,0,8,0"/>
                        <Button x:Name="SaveRunButton" Content="Save Run" Style="{StaticResource OrangeButton}" Width="104"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Bucket Locks" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Black" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="1" x:Name="LocksList" Style="{StaticResource DarkList}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Text="Saved / Clipped Runs" Foreground="{StaticResource Text}" FontSize="19" FontWeight="Black" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="3" x:Name="SavedRunsList" Style="{StaticResource DarkList}">
                        <ListBoxItem Content="Saved runs wire in after lockout test."/>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#050A10" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="12,0">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="Lockout test: open same bucket from two PCs/users to verify read-only mode" Foreground="#64748B" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
