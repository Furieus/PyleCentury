<Window x:Class="PyleCentury.Admin.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pyle Century Employee Manager"
        Height="760"
        Width="1240"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#071018">

    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PYLE" Foreground="#D1D5DB" FontWeight="Black" FontSize="30" FontStyle="Italic"/>
                    <TextBlock Text="⚡" Foreground="#F97316" FontWeight="Black" FontSize="32" Margin="6,-6,6,0"/>
                    <TextBlock Text="CENTURY" Foreground="#F97316" FontWeight="Black" FontSize="30" FontStyle="Italic"/>
                </StackPanel>
                <TextBlock Text="Employee Manager · Render Backend / Supabase Postgres"
                           Foreground="#94A3B8" FontSize="13" Margin="2,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ApiText" Text="API" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Refresh" Width="96" Style="{StaticResource ButtonStyle}" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#0B1620" BorderBrush="#263241" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Style="{StaticResource InputStyle}" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="AccessFilterBox" Height="34" Background="#111827" Foreground="#F8FAFC" BorderBrush="#374151" SelectedIndex="0" Margin="0,0,8,0">
                    <ComboBoxItem Content="All access levels"/>
                    <ComboBoxItem Content="Level 1"/>
                    <ComboBoxItem Content="Level 2"/>
                    <ComboBoxItem Content="Level 3"/>
                    <ComboBoxItem Content="Level 4"/>
                </ComboBox>
                <Button Grid.Column="2" Content="Search" Style="{StaticResource ButtonStyle}" Click="Search_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width=".85*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#0B1620" BorderBrush="#263241" BorderThickness="1" CornerRadius="14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Employees" Foreground="#F8FAFC" FontSize="18" FontWeight="Black" Margin="0,0,0,10"/>

                    <ListView Grid.Row="1" x:Name="UsersList"
                              Background="#071018"
                              Foreground="#F8FAFC"
                              BorderBrush="#263241"
                              SelectionChanged="UsersList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Employee ID" DisplayMemberBinding="{Binding EmployeeNumber}" Width="105"/>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding DisplayName}" Width="190"/>
                                <GridViewColumn Header="Windows Identity (optional)" DisplayMemberBinding="{Binding WindowsIdentity}" Width="230"/>
                                <GridViewColumn Header="Terminal" DisplayMemberBinding="{Binding HomeTerminalCode}" Width="85"/>
                                <GridViewColumn Header="Level" DisplayMemberBinding="{Binding AccessLevel}" Width="60"/>
                                <GridViewColumn Header="Active" DisplayMemberBinding="{Binding IsActive}" Width="70"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#0B1620" BorderBrush="#263241" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="Create / Edit Employee" Foreground="#F8FAFC" FontSize="18" FontWeight="Black" Margin="0,0,0,12"/>

                    <TextBlock Text="Windows Identity (optional)" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="WindowsIdentityBox" Style="{StaticResource InputStyle}" Margin="0,4,0,8"/>

                    <TextBlock Text="Windows Username" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="WindowsUsernameBox" Style="{StaticResource InputStyle}" Margin="0,4,0,8"/>

                    <TextBlock Text="Employee ID" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="EmployeeNumberBox" Style="{StaticResource InputStyle}" Margin="0,4,0,8"/>

                    <TextBlock Text="Display Name" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="DisplayNameBox" Style="{StaticResource InputStyle}" Margin="0,4,0,8"/>

                    <TextBlock Text="Home Terminal" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="HomeTerminalBox" Style="{StaticResource InputStyle}" Text="CON" Margin="0,4,0,8"/>

                    <TextBlock Text="Access Level" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold"/>
                    <ComboBox x:Name="AccessLevelBox" Height="34" Background="#111827" Foreground="#F8FAFC" BorderBrush="#374151" SelectedIndex="0" Margin="0,4,0,8">
                        <ComboBoxItem Content="1 - Home write / other terminals read / no Billing"/>
                        <ComboBoxItem Content="2 - All terminals write / no Billing"/>
                        <ComboBoxItem Content="3 - Dock read-only / Billing"/>
                        <ComboBoxItem Content="4 - Admin"/>
                    </ComboBox>

                    <CheckBox x:Name="IsActiveBox" Content="Active user" Foreground="#E5E7EB" IsChecked="True" Margin="0,6,0,14"/>

                    <WrapPanel>
                        <Button Content="New" Width="76" Style="{StaticResource ButtonStyle}" Click="New_Click" Margin="0,0,8,8"/>
                        <Button Content="Save" Width="86" Style="{StaticResource SaveButtonStyle}" Click="Save_Click" Margin="0,0,8,8"/>
                        <Button Content="Deactivate" Width="112" Style="{StaticResource ButtonStyle}" Click="Deactivate_Click" Margin="0,0,8,8"/>
                        <Button Content="Delete" Width="86" Style="{StaticResource ButtonStyle}" Click="Delete_Click" Margin="0,0,8,8"/>
                    </WrapPanel>

                    <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                        <TextBlock Text="Tip: run 'whoami' on the user's PC for the Windows Identity (optional) value. Example: COMPUTER\username."
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready" Foreground="#94A3B8" VerticalAlignment="Center"/>
    </Grid>
</Window>
